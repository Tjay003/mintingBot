{
  "manifest_version": 3,
  "name": "MintBot — OpenSea Fast Snipe Companion",
  "version": "1.0.0",
  "description": "High-performance NFT Minting & GTD Sniper for OpenSea & Robinhood Chain. Injected HUD, stage detection, and multi-wallet parallel blasting.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://opensea.io/*",
    "https://*.opensea.io/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MintBot Sniper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://opensea.io/*",
        "https://*.opensea.io/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "quick-snipe": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Instant 1-Click MintBot Snipe"
    }
  }
}
