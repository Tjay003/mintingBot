# ===========================
# Environment — NEVER COMMIT THIS FILE
# ===========================

# ─── RPC Endpoints ───────────────────────────────────────────────────────────
# Public Robinhood Chain RPC (free, rate-limited — good for testing)
RPC_HTTP_URL=https://rpc.mainnet.chain.robinhood.com
RPC_WSS_URL=wss://rpc.mainnet.chain.robinhood.com

# Private RPC (Alchemy / QuickNode — faster, recommended for real mints)
# Sign up free at: https://dashboard.alchemy.com
# Create an app → select "Robinhood" chain → copy the HTTPS and WSS URLs
PRIVATE_RPC_HTTP_URL=
PRIVATE_RPC_WSS_URL=

# ─── Wallet Private Keys ─────────────────────────────────────────────────────
# WARNING: Use dedicated bot wallets — NEVER your main wallet
# Export private key from MetaMask: Account Details → Export Private Key
# Format: 0x followed by 64 hex characters
WALLET_KEY_1=0x_your_private_key_here
WALLET_KEY_2=
WALLET_KEY_3=
WALLET_KEY_4=
WALLET_KEY_5=

# ─── Safety Limits ───────────────────────────────────────────────────────────
# Maximum gas price you're willing to pay (in Gwei). Bot aborts if exceeded.
MAX_GAS_PRICE_GWEI=50

# Maximum ETH to spend per single mint transaction (safety cap per wallet)
MAX_ETH_PER_MINT=0.5

# Maximum total ETH to spend across all wallets in one mint session
MAX_TOTAL_ETH=2.0

# ─── OpenSea API (optional — needed for resolving collection slugs) ────────────
# Get free key at: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=
