# ==============================================================================
# MintBot — Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES.
# NEVER COMMIT YOUR REAL .env FILE OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# ─── 1. RPC Endpoints (Robinhood Chain L2) ───────────────────────────────────
# Public RPC: Free & default, rate-limited
RPC_HTTP_URL=https://rpc.mainnet.chain.robinhood.com
RPC_WSS_URL=wss://rpc.mainnet.chain.robinhood.com

# Private / Dedicated RPC (Alchemy / QuickNode — recommended for fastest mint speeds)
# Create a free app at https://dashboard.alchemy.com, select Arbitrum Orbit / Robinhood Chain
PRIVATE_RPC_HTTP_URL=
PRIVATE_RPC_WSS_URL=

# ─── 2. Bot Wallet Private Keys ──────────────────────────────────────────────
# ⚠️ CRITICAL: Use dedicated burner/bot wallets ONLY — NEVER your main personal wallet!
# Export format: 0x followed by 64 hexadecimal characters
WALLET_KEY_1=0x_your_private_key_here
WALLET_LABEL_1=Burner 1

# Add additional burner wallets for parallel multi-wallet minting (up to 20):
# WALLET_KEY_2=
# WALLET_LABEL_2=Burner 2
# WALLET_KEY_3=
# WALLET_LABEL_3=Burner 3
# WALLET_KEY_4=
# WALLET_LABEL_4=Burner 4
# WALLET_KEY_5=
# WALLET_LABEL_5=Burner 5

# ─── 3. Cold Storage / Vault Recipient ───────────────────────────────────────
# (Optional) Master cold wallet address to receive auto-transferred NFTs or swept ETH dust
# Format: 0x followed by 40 hex characters
RECIPIENT_ADDRESS=

# ─── 4. Safety & Spending Limits ─────────────────────────────────────────────
# Maximum gas price (in Gwei) you are willing to pay. Transactions abort if gas spikes.
MAX_GAS_PRICE_GWEI=50

# Maximum ETH spent per single mint transaction across any wallet
MAX_ETH_PER_MINT=0.5

# Maximum cumulative ETH spent across all wallets in one minting session
MAX_TOTAL_ETH=2.0

# ─── 5. OpenSea API (Optional) ───────────────────────────────────────────────
# Needed if you want to resolve OpenSea collection slugs (e.g. opensea.io/collection/slug)
# Get a free API key at: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=

# ─── 6. Server & UI Port (Optional) ──────────────────────────────────────────
PORT=3000
