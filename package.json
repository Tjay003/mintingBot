{
  "name": "mintingbot",
  "version": "1.0.0",
  "description": "High-performance NFT minting bot for Robinhood Chain",
  "type": "module",
  "bin": {
    "mintbot": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "ui": "tsx server/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "mintbot": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "enquirer": "^2.4.1",
    "express": "^5.2.1",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.4.0",
    "node-fetch": "^3.3.2",
    "ora": "^8.1.0",
    "viem": "^2.21.0",
    "winston": "^3.13.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.2.4",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
